# copy to deploy/nightly-line.env, fill in, chmod 600.  Never paste this file anywhere.
TZ=America/New_York

# ---- dry run: set to 1 for the first day. Nothing reaches X or Discord; every
# post is logged as "DRY_RUN (not sent)". Set to 0 (or delete) at cutover.
DRY_RUN=1

# ---- sportsbook prices (The Odds API)
ODDS_API_KEY=

# ---- X (OAuth 1.0a user context; the four values from the X developer portal)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- Discord: OFF since 2026-10-01 (X + email only). Set DISCORD_ENABLED=1 and the
# DISCORD_WEBHOOK_* vars (see discordsink.CHANNELS) only if that ever changes.

# ---- email (replaces the Mac's claude + Gmail path)
MAIL_BACKEND=resend            # or smtp
RESEND_API_KEY=
MAIL_FROM=Nightly Line <alerts@yourdomain.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_TO=you@example.com
MAIL_BCC=                      # comma-separated, or blank

# ---- card renderer
CHROME_BIN=/usr/bin/chromium

ALERT_THRESHOLD=65
