# copy to deploy/nightly-line.env and fill in — chmod 600
ODDS_API_KEY=your_the_odds_api_key

MAIL_BACKEND=resend
RESEND_API_KEY=your_resend_key
MAIL_FROM=Nightly Line <alerts@yourdomain.com>

# or, instead of resend:
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you
# SMTP_PASS=app_password

MAIL_TO=YOUR_EMAIL@example.com
MAIL_BCC=BCC_RECIPIENT_1@example.com,BCC_RECIPIENT_2@example.com

ALERT_THRESHOLD=60
ACTIVE_FROM=8
ACTIVE_TO=23
TZ=America/New_York
