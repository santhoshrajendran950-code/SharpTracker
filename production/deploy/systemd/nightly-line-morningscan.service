[Unit]
Description=Nightly Line — 09:00 morning scan email
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nightly
WorkingDirectory=/opt/nightly-line
EnvironmentFile=/opt/nightly-line/deploy/nightly-line.env
ExecStart=/opt/nightly-line/run-scan.sh
# a stuck run must never overlap the next timer fire
TimeoutStartSec=900
