[Unit]
Description=Nightly Line — 23:59 results card
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nightly
WorkingDirectory=/opt/nightly-line
EnvironmentFile=/opt/nightly-line/deploy/nightly-line.env
ExecStart=/opt/nightly-line/run-picks-results.sh
# a stuck run must never overlap the next timer fire
TimeoutStartSec=900
