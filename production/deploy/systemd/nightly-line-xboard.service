[Unit]
Description=Nightly Line — X board cards at NFL/CFB waves
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nightly
WorkingDirectory=/opt/nightly-line
EnvironmentFile=/opt/nightly-line/deploy/nightly-line.env
ExecStart=/opt/nightly-line/deploy/xboard-waves.sh
# a stuck run must never overlap the next timer fire
TimeoutStartSec=600
